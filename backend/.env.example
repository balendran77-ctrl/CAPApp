# MongoDB Atlas Connection (replace placeholders)
# Example (replace <DB_USER>, <DB_PASSWORD> and <DB_NAME>):
# mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster0.byskwfv.mongodb.net/<DB_NAME>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster0.byskwfv.mongodb.net/<DB_NAME>?retryWrites=true&w=majority
# JWT Secret
JWT_SECRET=<YOUR_JWT_SECRET>

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Firebase Cloud Messaging (optional, for push notifications)
FCM_PROJECT_ID=your_fcm_project_id
FCM_PRIVATE_KEY=your_fcm_private_key
FCM_CLIENT_EMAIL=your_fcm_client_email

# Email Notifications (optional, for CAP assignment emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_FROM=CAP App <your_email@example.com>
